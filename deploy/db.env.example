# midrev-esp: poświadczenia kontenera Postgres (deploy/docker-compose.prod.yml, env_file).
# Miejsce: /srv/midrev-esp/shared/env/db.env   Prawa: root:root 600. Nigdy do gita.
#
# POSTGRES_PASSWORD ustawia hasło TYLKO przy pierwszym starcie z pustym wolumenem.
# Późniejsza zmiana tutaj nic nie zmienia w bazie: trzeba ALTER ROLE i DATABASE_URL.
# Generowanie (bez znaków wymagających kodowania w URL):
#   openssl rand -base64 48 | tr -d '/+=\n' | cut -c1-40
POSTGRES_USER=midrev_esp
POSTGRES_PASSWORD=
POSTGRES_DB=midrev_esp_prod
