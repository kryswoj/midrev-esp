# midrev-esp: konfiguracja backup.sh / restore.sh.
# Miejsce: /srv/midrev-esp/shared/env/backup.env   Prawa: root:root 600.
#
# Kopia wychodzi POZA serwer (rclone) i jest szyfrowana kluczem PUBLICZNYM age.
# Klucz prywatny powstaje na laptopie / w menedżerze haseł, NIGDY na serwerze:
#   age-keygen -o midrev-esp-backup.key      # na laptopie; plik do menedżera haseł
#   age-keygen -y midrev-esp-backup.key      # wypisze klucz publiczny age1...
# Klucz publiczny (jedna linia age1...) wpisz do AGE_RECIPIENTS_FILE. Można dać dwa
# klucze (np. Krystian + drugi człowiek), każdy w osobnej linii: odszyfruje każdy z nich.

# Zdalny cel rclone: <nazwa-remote>:<bucket-lub-katalog>. Remote konfigurujesz
# `rclone config --config /srv/midrev-esp/shared/env/rclone.conf` (README 3.4).
# Przykłady: b2-midrev:midrev-esp-backup | storagebox:midrev-esp | gdrive:midrev-esp-backup
RCLONE_REMOTE=
RCLONE_CONFIG=/srv/midrev-esp/shared/env/rclone.conf

# Klucz podpisu HMAC (pochodzenie backupu; restore produkcji bez poprawnego podpisu odmawia).
#   install -m 600 /dev/null backup-hmac.key && openssl rand -hex 32 > backup-hmac.key
# Kopia w menedżerze haseł (przy odtwarzaniu na nowym serwerze: restore.sh --klucz-podpisu).
HMAC_KEY_FILE=/srv/midrev-esp/shared/env/backup-hmac.key

# plik z kluczem/kluczami publicznymi age (age1...), prawa 644 wystarczą
AGE_RECIPIENTS_FILE=/srv/midrev-esp/shared/env/backup-recipients.txt

# Retencja PO LICZBIE plików (nie po dacie): zepsuty backup nie wyczyści starych kopii.
ZOSTAW_DZIENNYCH=14
ZOSTAW_TYGODNIOWYCH=8
# lokalne kopie szyfrogramu na tym samym dysku (tylko wygoda przy szybkim odtworzeniu)
ZOSTAW_LOKALNYCH=2
# Kasowanie zdalne przez skrypt (1) wymaga klucza rclone z prawem usuwania, a wtedy
# ktoś z rootem na serwerze skasuje też kopie. ZALECANE 0: klucz BEZ prawa usuwania +
# reguła cyklu życia w buckecie (np. B2 lifecycle: daily/ 15 dni, weekly/ 60 dni).
# 1 tylko świadomie (np. Google Drive bez reguł cyklu życia).
RETENCJA_ZDALNA=0

# Próbne odtworzenie każdego zrzutu do tymczasowej bazy <baza>_backup_check i porównanie
# liczby wierszy. 1 = zawsze (zalecane; baza pilota to dziesiątki MB).
PROBNE_ODTWORZENIE=1

# Progi weryfikacji zrzutu (po migracjach 0001-0028 jest ok. 45 tabel)
MIN_DUMP_BAJTOW=20000
MIN_TABEL=40

# Opcjonalnie: dead man's switch (np. healthchecks.io). Adres pingowany po sukcesie;
# serwis alarmuje, gdy ping nie przyjdzie (np. cały serwer leży, timer nie działa).
PING_URL=

# Nazwa w pliku: midrev-esp-<przyrostek>-<UTC>.tar.age
NAZWA_PRZYROSTEK=prod
