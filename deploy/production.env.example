# midrev-esp: środowisko PRODUKCJI. JEDEN plik dla panelu i workera (systemd EnvironmentFile=)
# oraz dla migracji uruchamianych przez deploy.sh (systemd-run z tym samym plikiem).
#
# Miejsce:   /srv/midrev-esp/shared/env/production.env
# Prawa:     root:root 600   (install -m 600 -o root -g root /dev/null production.env)
#            systemd czyta plik jako root i przekazuje zmienne procesom; użytkownik
#            midrev-esp nie potrzebuje prawa odczytu pliku.
# Format:    systemd EnvironmentFile: KLUCZ=wartość, bez `export`, bez rozwijania $ZMIENNYCH,
#            bez spacji wokół "=". Wartości bez cudzysłowów (URL-e są już zakodowane).
# NIGDY do gita, NIGDY w tym samym archiwum co backup bazy.
#
# Wartości generujesz na serwerze komendami podanymi przy każdej zmiennej. Kopię
# SECRETS_KEY i SUPPRESSION_HASH_KEY zapisz w menedżerze haseł ZANIM uruchomisz produkcję.

# --- tryb ---------------------------------------------------------------------------
# Wymuszany też w ExecStart unitów, ale wpisany jawnie (worker = node, nie ustawia go sam).
NODE_ENV=production

# MIDREV_SANDBOX: na produkcji NIE USTAWIAĆ (nawet pustej). Unity mają
# UnsetEnvironment=MIDREV_SANDBOX, a deploy.sh odmawia wdrożenia, gdy jest w tym pliku.

# --- baza ---------------------------------------------------------------------------
# Postgres z deploy/docker-compose.prod.yml, port tylko na 127.0.0.1. Hasło = POSTGRES_PASSWORD
# z db.env (to samo hasło w dwóch plikach: zmiana hasła = oba pliki + ALTER ROLE).
# Hasło bez znaków wymagających kodowania w URL:
#   openssl rand -base64 48 | tr -d '/+=\n' | cut -c1-40
# statement_timeout chroni przed zawieszonym zapytaniem trzymającym połączenie z puli.
DATABASE_URL=postgresql://midrev_esp:<HASLO>@127.0.0.1:5432/midrev_esp_prod?options=-c%20statement_timeout%3D30000

# --- adresy -------------------------------------------------------------------------
# Panel operatora (logowanie, ciasteczko sesji Secure, server actions, akceptacja kampanii,
# webhooki sklepów Woo). Tylko https, bez "/" na końcu.
APP_URL=https://esp.midrev.pl
# Wszystko, co widzi ODBIORCA maila: klik /r, wypis /u + List-Unsubscribe, pixel /api/o,
# obrazy /o, skrypt popupu /s, /api/popup. Caddy na tym hoście przepuszcza TYLKO te trasy.
# Ustalić RAZ, przed pierwszym obrazem i pierwszą kampanią: linki w wysłanych mailach
# i adresy obrazów w treściach żyją latami. Tylko https, bez "/" na końcu.
TRACKING_URL=https://link.midrev.pl

# --- klucze -------------------------------------------------------------------------
# AES-256-GCM dla haseł SMTP/IMAP i kluczy sklepów w bazie. 64 znaki hex:
#   openssl rand -hex 32
# Kopia w menedżerze haseł, OSOBNO od backupu. Utrata = ponowne wpisanie wszystkich haseł
# w panelu (backup bazy bez tego klucza ma bezużyteczne szyfrogramy poświadczeń).
SECRETS_KEY=
# HMAC haszy adresów na liście wykluczeń i nagrobków RODO. INNY niż SECRETS_KEY:
#   openssl rand -hex 32
# Kopia w menedżerze haseł. Utrata = nagrobki RODO przestają rozpoznawać adresy
# (osoba po art. 17 może wrócić importem). Tego klucza nie wolno nigdy zmienić.
SUPPRESSION_HASH_KEY=

# --- alerty -------------------------------------------------------------------------
# Kanał techniczny (Discord: pole content, Slack: text). Używają go: aplikacja (worker),
# deploy.sh, backup.sh, healthcheck.sh. Bez niego alerty lądują tylko w logu = nikt ich
# nie zobaczy. Discord: Ustawienia kanału -> Integracje -> Webhooki -> Kopiuj URL.
ALERT_WEBHOOK_URL=

# --- proxy i healthcheck -------------------------------------------------------------
# Skąd aplikacja bierze adres klienta do limitów (logowanie, popup). Caddy NADPISUJE
# X-Forwarded-For adresem klienta i ustawia X-Real-IP, więc obie wartości są poprawne.
TRUSTED_PROXY=ostatni-xff
# Opcjonalnie: token do /api/zdrowie?szczegoly=1 (liczby kolejki i held). Bez niego trasa
# zwraca tylko flagi ok/baza/worker. Generowanie: openssl rand -hex 24
# ZDROWIE_TOKEN=

# --- wysyłka ------------------------------------------------------------------------
# Na produkcji PUSTE / nieobecne. Ustawione = proces odmawia startu (i deploy.sh też).
# SMTP_HOSTY_DEWELOPERSKIE=

# Rozmiar partii; między partiami silnik sprawdza wstrzymanie i progi reputacji. 1..1000.
WYSYLKA_ROZMIAR_PARTII=100

# Ścieżka „domyślna" (tenant bez własnego serwera SMTP) to dziś serwer pod Mailpita
# (raport 02, P1-1). NIE ustawiać SMTP_HOST na prawdziwy serwer: każdy tenant ma własny
# SMTP (SES) w panelu. Zostawić zakomentowane.
# SMTP_HOST=
# SMTP_PORT=
# MAIL_FROM=

# --- środowisko uruchomieniowe ------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1
# Kod liczy strefę jawnie (strefa.ts); TZ tylko dla czytelności logów aplikacji.
TZ=Europe/Warsaw
# Tylko przy więcej niż jednej instancji panelu albo buildzie na innej maszynie:
#   openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
