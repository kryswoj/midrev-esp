# midrev-esp: reverse proxy produkcji (osobny VPS). Instalacja: /etc/caddy/Caddyfile
# (provision.sh kopiuje, waliduje i przeładowuje; każda późniejsza zmiana WYMAGA ZGODY).
#
# Dwa hosty na JEDNYM procesie Next (127.0.0.1:3100):
#   esp.midrev.pl   panel operatora (cały), webhooki sklepów, akceptacja kampanii
#   link.midrev.pl  WYŁĄCZNIE trasy, które woła odbiorca maila albo strona sklepu:
#                   /r (klik), /u (wypis + RFC 8058 One-Click POST), /api/o (pixel),
#                   /o (obrazy w mailach), /s (skrypt popupów), /api/popup (dane i zapis
#                   popupu), /js/v1/{klucz}.js (skrypt midrev.js, 0044), /client/{events,
#                   profiles,subscriptions} (Client API zgodne z Klaviyo, klucz publiczny
#                   strony w ?company_id=). Wszystko inne na link. = 404 z Caddy, zanim dotknie aplikacji.
#                   Lista pochodzi z src/trasy-publiczne.ts (TRASY_PUBLICZNE) po odjęciu
#                   tras panelu, sklepu i klienta agencji (/logowanie, /_next, /favicon.ico,
#                   /akceptacja, /api/webhooks, /api/zdrowie). Nowa trasa odbiorcy = dopisać tutaj.
#
# Walidacja bez uruchamiania:  caddy validate --config deploy/Caddyfile --adapter caddyfile
# Przeładowanie (atomowe; zły plik = Caddy zostaje na starej konfiguracji):
#                              systemctl reload caddy
{
	# konto ACME Let's Encrypt (powiadomienia o wygasaniu certyfikatów)
	email krystian@midrev.pl
	# admin API tylko lokalnie (domyślnie i tak localhost:2019; zapisane jawnie)
	admin localhost:2019
	servers {
		# Caddy stoi na brzegu: żadnemu nagłówkowi X-Forwarded-* od klienta nie ufamy
		# (brak trusted_proxies = {remote_host} to zawsze prawdziwy adres połączenia).
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

# Nagłówki wspólne obu hostów. `defer` = ustawiane po odpowiedzi aplikacji, więc
# usuwanie X-Powered-By działa także, gdy Next go dołoży.
(wspolne) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
		-Server
		-X-Powered-By
		defer
	}
}

# Nadpisanie (nie doklejenie!) adresu klienta. Aplikacja liczy limit prób logowania
# i limit popupu po PIERWSZYM wpisie X-Forwarded-For; gdyby proxy doklejało, pierwszy
# wpis podawałby atakujący.
(upstream) {
	reverse_proxy 127.0.0.1:3100 {
		header_up X-Real-IP {remote_host}
		# Caddy bez trusted_proxies i tak zastępuje XFF (walidator ostrzega „Unnecessary
		# header_up”); zostaje jawnie, żeby zmiana domyślnych Caddy nie zmieniła zachowania.
		header_up X-Forwarded-For {remote_host}
		# Host przechodzi bez zmian (domyślne zachowanie Caddy); server actions Nexta
		# porównują Origin z Host, więc nie wolno go przepisywać.
	}
}

esp.midrev.pl {
	import wspolne

	# Import CSV profili do 50 MB (import-klaviyo/pliki.ts) + narzut multipart/nagłówków.
	request_body {
		max_size 60MB
	}

	# Nagłówki bezpieczeństwa panelu. Znak `?` = ustaw tylko, jeśli aplikacja nie wysłała
	# własnego: gdy next.config.ts zacznie je dawać, nie będzie duplikatów ani konfliktu.
	header {
		?X-Frame-Options "DENY"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		defer
	}

	encode zstd gzip

	import upstream

	log {
		output file /var/log/caddy/esp.midrev.pl.access.log {
			roll_size 50MiB
			roll_keep 14
			roll_keep_for 336h
		}
		format json
	}
}

link.midrev.pl {
	import wspolne

	# Na trasach odbiorcy nie ma uploadu: popup ma własny limit ciała w aplikacji,
	# one-click wypis to kilkadziesiąt bajtów.
	request_body {
		max_size 1MB
	}

	header ?X-Content-Type-Options "nosniff"

	# Dopasowanie po CAŁYCH segmentach i z rozróżnieniem wielkości liter (path_regexp,
	# nie `path`, bo `path` w Caddy ignoruje wielkość liter, a Next nie). Token jest
	# zawsze jednym segmentem: /r/{token}, /u/{token}, /api/o/{sha}.gif, /o/{token}.{ext},
	# /s/{tenantId}, /api/popup/{popupId}. Segment `.`/`..` odpada w regexie.
	# Do tego metody: nowy handler POST/PUT pod tym samym prefiksem nie staje się sam
	# publiczny na domenie linków.
	@odbiorca_odczyt {
		path_regexp odczyt ^/(?:r|o|s|api/o)/[A-Za-z0-9_~-][A-Za-z0-9._~-]*$
		method GET HEAD
	}
	# wypis: GET strona z przyciskiem, POST formularz i RFC 8058 One-Click
	@odbiorca_wypis {
		path_regexp wypis ^/u/[A-Za-z0-9_~-][A-Za-z0-9._~-]*$
		method GET HEAD POST
	}
	# popup na stronie sklepu: konfiguracja (GET), zapis (POST), preflight CORS (OPTIONS)
	@odbiorca_popup {
		path_regexp popup ^/api/popup/[A-Za-z0-9_~-][A-Za-z0-9._~-]*$
		method GET HEAD POST OPTIONS
	}

	# integracja custom (0044): skrypt midrev.js po kluczu publicznym strony (6-10 znaków)
	@odbiorca_skrypt {
		path_regexp skrypt ^/js/v1/[A-Za-z0-9]{6,10}\.js$
		method GET HEAD
	}
	# Client API zgodne z Klaviyo: zapis zdarzeń, identyfikacja, subskrypcja z dowodem zgody;
	# z ukośnikiem na końcu i bez (klaviyo.js woła `/client/events/`), preflight CORS (OPTIONS)
	@odbiorca_klient {
		path_regexp klient ^/client/(?:events|profiles|subscriptions)/?$
		method POST OPTIONS
	}

	handle @odbiorca_odczyt {
		import upstream
	}
	handle @odbiorca_skrypt {
		import upstream
	}
	handle @odbiorca_klient {
		import upstream
	}
	handle @odbiorca_wypis {
		import upstream
	}
	handle @odbiorca_popup {
		import upstream
	}

	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}

	# Wszystko inne: panel, /logowanie, /_next, /api/webhooks, /akceptacja, /api/zdrowie...
	# nie istnieje pod domeną śledzenia.
	handle {
		respond "Nie znaleziono" 404
	}

	log {
		# Log /u jest potrzebny po odtworzeniu bazy ze starszego backupu (wypisy z luki
		# trzeba wprowadzić przed startem workera), stąd 30 dni. To dane osobowe (IP),
		# dłużej nie trzymamy.
		output file /var/log/caddy/link.midrev.pl.access.log {
			roll_size 100MiB
			roll_keep 30
			roll_keep_for 720h
		}
		format json
	}
}

# ── api.midrev.pl: API zgodne z Klaviyo (plan metryki-i-profil 2.1, decyzja D2) ────────
# NIEAKTYWNE. Włączenie wymaga ZGODY Krystiana i dwóch zmian na produkcji (CLAUDE.md,
# procedura: co, dlaczego, promień rażenia, jak cofnąć):
#   1. DNS: rekord A/AAAA api.midrev.pl -> IP VPS-a produkcji (Hostido),
#   2. odkomentowanie bloku niżej, `caddy validate`, `systemctl reload caddy`.
# Cofnięcie: ponowne zakomentowanie bloku + reload (DNS może zostać).
#
# Dlaczego osobny host (jak a.klaviyo.com): klient wkleja klucz API pod adres, na którym
# panel i jego ciasteczka W OGÓLE nie istnieją; osobne limity ciała i logi. Tylko trasy
# API (lista z src/trasy-publiczne.ts: TRASY_PUBLICZNE + TRASY_API_Z_UKOSNIKIEM), z
# ukośnikiem na końcu i bez (n8n woła `/api/events/`; aplikacja przepisuje go bez 308).
# Metody: tylko POST (i OPTIONS dla przyszłych /client/* z CORS). Reszta = 404 JSON:API.
# Kolejne trasy E3/E7 (profile-import, profiles, client) dopisywać do @api_klaviyo.
#
# api.midrev.pl {
# 	import wspolne
#
# 	# POST /api/events: do 5 MB w aplikacji (przeczytajOgraniczone), tu zapas na nagłówki
# 	request_body {
# 		max_size 6MB
# 	}
#
# 	header ?X-Content-Type-Options "nosniff"
#
# 	@api_klaviyo {
# 		path_regexp api ^/api/events/?$
# 		method POST
# 	}
# 	# Client API (0044): to samo co na link., gdyby strony miały wołać api.midrev.pl
# 	@api_klient {
# 		path_regexp klient ^/client/(?:events|profiles|subscriptions)/?$
# 		method POST OPTIONS
# 	}
# 	handle @api_klient {
# 		import upstream
# 	}
# 	handle @api_klaviyo {
# 		import upstream
# 	}
#
# 	handle {
# 		header Content-Type "application/vnd.api+json"
# 		respond `{"errors":[{"status":404,"code":"not_supported","title":"This endpoint is not supported.","detail":"Only the Klaviyo-compatible subset is available on this host.","source":{}}]}` 404
# 	}
#
# 	log {
# 		# nagłówek Authorization NIE trafia do logu: Caddy domyślnie go redaguje
# 		# (log_credentials wyłączone), zostaje metoda, ścieżka, status, IP
# 		output file /var/log/caddy/api.midrev.pl.access.log {
# 			roll_size 100MiB
# 			roll_keep 14
# 			roll_keep_for 336h
# 		}
# 		format json
# 	}
# }
