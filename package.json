{
  "name": "midrev-esp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sandbox:up": "docker compose up -d",
    "sandbox:down": "docker compose down",
    "migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "worker": "node --env-file=.env --import tsx src/jobs/worker.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^1.47.0",
    "next": "^16.3.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  }
