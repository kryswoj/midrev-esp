DATABASE_URL=postgresql://midrev:midrev@localhost:5433/midrev_esp
# Tylko dev: serwery SMTP "host:port" dopuszczone mimo blokady adresow prywatnych.
# Nigdy na produkcji (proces odmowi startu przy NODE_ENV=production).
SMTP_HOSTY_DEWELOPERSKIE=127.0.0.1:1025

# Alerty do czlowieka (NFR38): kazdy alert (wyczerpane proby joba, cisza sklepu, rozjazd
# danych, wstrzymanie wysylki) idzie POST-em JSON na ten adres. Payload:
#   { poziom: "info"|"uwaga"|"krytyczny", tenant, tresc, kiedy, content, text }
# `content` dziala z gołym webhookiem Discorda, `text` ze Slackiem/Mattermostem.
# Bez tej zmiennej alerty laduja WYLACZNIE w logu workera, ktorego nikt nie czyta.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Klucz HMAC (32 bajty hex) do haszy adresow na globalnej liscie wykluczen (RODO, 0022).
# Osobny od SECRETS_KEY - rotacja klucza szyfrowania nie uniewaznia zaslepek. Bez niego
# aplikacja uzywa klucza pochodnego od SECRETS_KEY (tylko sandbox; produkcja odmowi startu).
# openssl rand -hex 32
# SUPPRESSION_HASH_KEY=

# Baza TESTOW (vitest). Musi konczyc sie na "_test" - inaczej testy odmowia startu.
# Zakladana i migrowana automatycznie przez tests/global-setup.ts. Bez tej zmiennej
# testy uzywaja ponizszego domyslnego adresu sandboxa.
# TEST_DATABASE_URL=postgresql://midrev:midrev@localhost:5433/midrev_esp_test

# ─────────────────────────────────────────────────────────────────────────────
# Tryb sandboxa. DEV i TESTY: MIDREV_SANDBOX=1 (wyłącza guardy produkcyjne: https,
# klucze, wymagane alerty, blokadę ścieżki domyślnej przez Mailpita).
# PRODUKCJA: NIE ustawiać. Brak flagi = produkcja, niezależnie od NODE_ENV — worker
# NODE_ENV nie dostaje, a to on wkleja adresy do maili. MIDREV_SANDBOX=1 razem z
# NODE_ENV=production = odmowa startu.
MIDREV_SANDBOX=1

# Ponowne wejście do automatyzacji („za każdym razem”, „po upływie czasu”). Włączać
# DOPIERO po migracji 0036 (migrations-pending/, osobne wydanie). Bez 0036 kod i tak
# odmówi (sprawdza w bazie, że stare unikalności zniknęły).
# MIDREV_PONOWNE_WEJSCIE=1

# Filtr wyzwalacza i metryki spoza wbudowanych (graf automatyzacji v2). Stary kod sprzed
# tego wydania nie czyta v2: włączać po weryfikacji wydania, gdy rollback nie jest planowany.
# MIDREV_GRAF_V2=1

# ─────────────────────────────────────────────────────────────────────────────
# PRODUKCJA: jeden plik środowiska dla panelu i workera
#
#   /etc/midrev-esp/env (prawa 600, właściciel = użytkownik usługi), wczytywany przez
#   systemd `EnvironmentFile=/etc/midrev-esp/env` w OBU unitach:
#     panel:  ExecStart=npx next start -H 127.0.0.1 -p <port>
#     worker: ExecStart=npm run worker:prod     (node --import tsx src/jobs/worker.ts)
#     migracje: npm run migrate:prod            (z tym samym plikiem: set -a; . /etc/midrev-esp/env)
#   `next build` też z załadowanym plikiem (nagłówki HSTS liczone są przy buildzie).
#
#   W katalogu aplikacji NIE MA plików .env, .env.local, .env.production,
#   .env.production.local: Next czyta je sam, worker nie, więc panel i worker
#   rozjechałyby się po cichu. Poza sandboksem oba procesy odmawiają startu, gdy
#   którykolwiek z tych plików istnieje (src/walidacja-startowa.ts).
#
#   Wymagane poza sandboksem (brak = proces odmawia startu, komunikat nazywa zmienną):
#     DATABASE_URL, SECRETS_KEY (openssl rand -hex 32), SUPPRESSION_HASH_KEY (inny
#     niż SECRETS_KEY), APP_URL (https, nazwa domenowa, bez ścieżki),
#     ALERT_WEBHOOK_URL (https), TRUSTED_PROXY (jawna decyzja), puste SMTP_HOSTY_DEWELOPERSKIE.
# ─────────────────────────────────────────────────────────────────────────────

# Adres PANELU: logowanie, ciasteczko sesji, akceptacja kampanii, webhooki sklepów.
# APP_URL=https://esp.midrev.pl

# Opcjonalna domena ŚLEDZENIA: kliki /r, pixel /api/o, wypis /u + List-Unsubscribe,
# obrazy /o, skrypt popupów /s i /api/popup. Brak = APP_URL. Linki w wysłanych mailach
# żyją latami: ustawić RAZ, przed pierwszym obrazem i kampanią. Proxy na tej domenie
# przepuszcza tylko ścieżki odbiorcy (lista: src/trasy-publiczne.ts).
# TRACKING_URL=https://link.midrev.pl

# Skąd brać adres klienta do limitów (logowanie, popup) za reverse proxy. Poza sandboksem
# WYMAGANE jawnie (brak = odmowa startu), w sandboksie domyślnie ostatni-xff:
#   ostatni-xff             - ostatni wpis X-Forwarded-For (Caddy nadpisuje XFF adresem
#                             klienta, nginx z proxy_add_x_forwarded_for dopisuje go na końcu)
#   x-real-ip               - nagłówek X-Real-IP ustawiany przez proxy
#   brak                    - bez proxy: nagłówkom nie ufamy (wspólny licznik)
# TRUSTED_PROXY=ostatni-xff

# Opcjonalny token do szczegółów healthchecku: GET /api/zdrowie?szczegoly=1 z nagłówkiem
# Authorization: Bearer <token> (kolejka, held). Bez tokenu trasa podaje tylko stan.
# openssl rand -hex 32
# ZDROWIE_TOKEN=
